DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=1502588698246778960

# Gemma/Gemini API keys.
# Use one key, or comma-separated keys for fallback rotation.
GEMINI_API_KEYS=your_gemini_api_key_here

# Main text model and fallback text models.
# Good Gemini text-model examples as of 2026-08-06:
# gemini-3.6-flash, gemini-3.5-flash, gemini-3.5-flash-lite,
# gemini-3.1-flash-lite, gemini-2.5-flash, gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-2.5-flash,gemma-4-26b-a4b-it,gemma-4-31b-it

# Vision model for image prompts.
# Good Gemini vision-capable examples as of 2026-08-06:
# gemini-flash-latest, gemini-3.6-flash, gemini-3.5-flash,
# gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-flash-latest
GEMINI_VISION_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash

# Optional Discord command cleanup target.
# If set, npm run register clears server-only commands here to avoid duplicates.
GUILD_ID=

# Optional runtime settings.
PORT=8080
TETRIO_LEAGUE_DATA_DIR=
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_MAX_ATTEMPTS_PER_MODEL=3
GEMINI_TIMING_LOGS=true
GEMINI_MEMORY_DAYS=365
GEMINI_MEMORY_MAX_MESSAGES_PER_SESSION=50
GEMINI_MEMORY_MAX_ENTRY_LENGTH=4000
GEMINI_MEMORY_MAX_CONTEXT_LENGTH=32000
GEMINI_IMAGE_MAX_BYTES=8388608

# Optional web-search breadth. Results are summarized by Gemini and split into Discord messages as needed.
WEB_SEARCH_MAX_RESULTS=12
WEB_SEARCH_SOURCE_COUNT=12

# Optional local PyHok wiki search via Meilisearch.
PYHOK_WIKI_SEARCH_ENABLED=false
PYHOK_WIKI_BASE_URL=https://pyhok.com
PYHOK_MEILI_URL=http://127.0.0.1:7700
PYHOK_MEILI_INDEX=TheTreeDocuments
PYHOK_MEILI_KEY=
PYHOK_WIKI_MAX_RESULTS=5
PYHOK_WIKI_TIMEOUT_MS=5000
PYHOK_WIKI_MAX_CONTEXT_LENGTH=12000

# Optional chess image recognition and Stockfish settings.
CHESS_IMAGE_PYTHON=
CHESS_IMAGE_TIMEOUT_MS=120000
CHESS_IMAGE_MAX_BYTES=8388608
CHESS_IMAGE_CONFIDENCE_WARN=0.75
CHESS_IMAGE_CONFIDENCE_REJECT=0.35
CHESS_IMAGE_PIECE_CONFIDENCE_REJECT=0.65
CHESS_IMAGE_MAX_LOW_CONFIDENCE_SQUARES=16
CHESS_STOCKFISH_MOVETIME_MS=2000

# Optional Lichess opening-book settings for bot-vs-user chess play.
CHESS_OPENING_ENABLED=true
CHESS_OPENING_PLAYER=bears4347
CHESS_OPENING_SPEEDS=blitz,rapid,classical
CHESS_OPENING_MODES=rated
CHESS_OPENING_MAX_PLY=18
CHESS_OPENING_MIN_GAMES=2
CHESS_OPENING_STYLE=mimic
CHESS_OPENING_NETWORK_ENABLED=false
CHESS_OPENING_TIMEOUT_MS=3500
CHESS_OPENING_PRELOAD_MAX_NODES=250
CHESS_OPENING_PRELOAD_BRANCHES=12
CHESS_OPENING_PRELOAD_DELAY_MS=60
# CHESS_OPENING_CACHE_PATH=

# Optional MinoMuncher replay upload limit.
MINOMUNCHER_REPLAY_MAX_BYTES=26214400

# Optional guild list refresh interval for the "current bot guild list" message.
GUILD_LIST_REFRESH_INTERVAL_MS=1800000

# Optional VM status dashboard.
# Create a private status channel, copy its channel ID, and set it here.
VM_STATUS_CHANNEL_ID=
VM_STATUS_MESSAGE_ID=
VM_STATUS_INTERVAL_MS=5000
VM_STATUS_DISK_PATH=/


CLOUDFLARE_ACCOUNT_ID=여기에_계정_ID
CLOUDFLARE_AI_API_TOKEN=여기에_API_토큰
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Optional MinoMuncher isolation/security settings.
MINOMUNCHER_WORKER_TIMEOUT_MS=30000
MINOMUNCHER_WORKER_HEAP_MB=1024
MINOMUNCHER_WORKER_RSS_LIMIT_MB=768
MINOMUNCHER_WORKER_RSS_POLL_MS=100
MINOMUNCHER_MAX_CONCURRENCY=1

MINOMUNCHER_VALIDATION_MAX_FILES=10
MINOMUNCHER_VALIDATION_MAX_SINGLE_BYTES=26214400
MINOMUNCHER_VALIDATION_MAX_TOTAL_BYTES=67108864
MINOMUNCHER_VALIDATION_MAX_FRAME=2000000
MINOMUNCHER_VALIDATION_MAX_BOARD_WIDTH=100
MINOMUNCHER_VALIDATION_MAX_BOARD_HEIGHT=400
MINOMUNCHER_VALIDATION_MAX_EVENTS=500000
MINOMUNCHER_VALIDATION_MAX_NODES=2000000
MINOMUNCHER_VALIDATION_MAX_DEPTH=128